# Enquiry form delivery. Configure at least one channel, otherwise the form tells visitors
# that online enquiries aren't connected yet and offers WhatsApp instead.
# Copy to .env.local for local testing; add the same values in your hosting dashboard.

# 1) Any webhook that accepts JSON (Google Apps Script / Sheets, Zapier, Make, a CRM)
LEAD_WEBHOOK_URL=

# 2) Email via Resend (https://resend.com). LEAD_EMAIL_TO can be comma-separated.
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# 3) Salesforce Web-to-Lead: your org's OID (Setup -> Web-to-Lead)
SALESFORCE_WEB_TO_LEAD_OID=

# "Ask ARA" AI assistant (any OpenAI-compatible provider). The chat stays hidden until all three are set.
#   Groq:   AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=openai/gpt-oss-120b
#   OpenAI: AI_BASE_URL=https://api.openai.com/v1        AI_MODEL=gpt-4o-mini
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
